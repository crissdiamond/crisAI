# crisAI environment configuration
# Copy this file to `.env` and fill in the values you need.
# Do not commit your real `.env` file or any live credentials.

# --- Model provider credentials ---
# The default registry/agents.yaml uses OpenAI, Gemini, and DeepSeek model refs.
# Fill these three keys for the default setup, or copy a mono-provider example
# from registry/examples/agents.*.yaml over registry/agents.yaml.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# --- Default runtime model ---
# Used as a general default where applicable.
CRISAI_DEFAULT_MODEL=gpt-5.4-mini

# --- Vision MCP server ---
# OpenAI model used by the vision server to describe images and PowerPoint pictures.
# CRISAI_VISION_MODEL=gpt-4o-mini

# --- OpenAI Agents SDK (optional) ---
# Set to true to stop sending traces to OpenAI (no effect on crisAI JSONL trace files).
# OPENAI_AGENTS_DISABLE_TRACING=true

# --- Agent execution limits ---
# Maximum turns an agent may take before the run is aborted with a 422.
# CRISAI_AGENT_MAX_TURNS=30
# Maximum seconds allowed for one pipeline/peer agent stage before it is failed and traced.
# CRISAI_AGENT_STAGE_TIMEOUT_SECONDS=300

# --- Retrieval checkpoint ---
# Pause after pipeline retrieval so the user can continue, redirect retrieval, or stop before drafting.
CRISAI_RETRIEVAL_CHECKPOINT_ENABLED=true
# Maximum redirect attempts allowed at one retrieval checkpoint.
CRISAI_RETRIEVAL_CHECKPOINT_MAX_REDIRECTS=2

# --- Session memory ---
# Runtime override for compact task memory. Defaults come from registry/session_memory.yaml.
# CRISAI_SESSION_MEMORY_STRATEGY=deterministic
# CRISAI_SESSION_MEMORY_AGENT_ID=memory_summarizer
# CRISAI_SESSION_MEMORY_MAX_RECENT_TURNS=2
# CRISAI_SESSION_MEMORY_MAX_RUNTIME_CHARS=6000
# CRISAI_SESSION_MEMORY_MAX_MEMORY_CHARS=3000
# CRISAI_SESSION_MEMORY_TASK_DRIFT_NUDGE=true

# --- MCP stdio clients (optional) ---
# Seconds for MCP session requests (list_tools, tool calls). Heavy servers (SharePoint) need more than the SDK default of 5.
# CRISAI_MCP_CLIENT_TIMEOUT_SECONDS=60

# --- Local paths ---
# These may be absolute paths or paths relative to the repository root.
CRISAI_WORKSPACE_DIR=./workspace
CRISAI_LOG_DIR=./logs
CRISAI_REGISTRY_DIR=./registry

# --- Logging ---
# CRISAI_LOG_LEVEL=INFO

# --- CLI experience ---
# classic uses stable Rich panels. fullscreen is experimental until the chat loop
# is moved to a true full-screen prompt-toolkit application.
CRISAI_CLI_EXPERIENCE=classic
# Optional terminal-title OSC updates. Keep disabled if your terminal shows
# visible ]0;... text in the chat transcript.
CRISAI_TERMINAL_TITLE_ENABLED=false

# --- Workspace write controls ---
# Maximum bytes for a single workspace write_workspace_file / append_workspace_file call.
# CRISAI_WORKSPACE_MAX_WRITE_BYTES=1000000
# Comma-separated subdirectories the workspace server is allowed to write to.
# CRISAI_WORKSPACE_WRITE_SUBDIRS=outputs,scratch,knowledge_staging,tasks
# Comma-separated file extensions the workspace server is allowed to write.
# CRISAI_WORKSPACE_WRITE_EXTENSIONS=.md,.txt,.json,.yaml,.yml,.csv,.mmd

# --- Diagram server write controls ---
# Maximum bytes for a single save_diagram call.
# CRISAI_DIAGRAM_MAX_WRITE_BYTES=500000

# --- Optional SharePoint / Microsoft Entra settings ---
# Enable these only if you are using the SharePoint integration.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost
MS_TOKEN_CACHE_PATH=.tokens/msal_token_cache.json
# MS_TOKEN_INFO_PATH=.tokens/ms_token_info.json

# Optional defaults for SharePoint discovery
MS_GRAPH_SCOPES=User.Read,Files.Read.All,Sites.Read.All

# --- Intranet and peer workflow tuning ---
# Intranet page catalogue cache TTL (hours) for intranet_list_all_pages
INTRANET_PAGE_CACHE_TTL_HOURS=4

# Deterministic retrieval advisory MCP lookups (peer challenger/judge guidance)
# false by default; canonical deterministic context remains authoritative
CRISAI_DETERMINISTIC_MCP_ADVISORY=false

# Peer mode: max extra refiner/judge rounds after initial judge pass
CRISAI_PEER_MAX_REFINEMENT_ROUNDS=2

# Peer mode: max structural escalation attempts (author/challenger rerun)
# when revise loops remain unresolved
CRISAI_PEER_MAX_ESCALATIONS=1
