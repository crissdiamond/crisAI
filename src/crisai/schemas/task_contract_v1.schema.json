{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crisai.local/schemas/task_contract_v1.schema.json",
  "title": "Task Contract",
  "type": "object",
  "required": [
    "schema_version",
    "primary_intent",
    "deliverable_type",
    "source_resolution",
    "required_evidence_level",
    "success_criteria",
    "anti_goals"
  ],
  "properties": {
    "schema_version": { "const": "task_contract_v1" },
    "primary_intent": { "type": "string", "minLength": 1 },
    "deliverable_type": { "type": "string", "minLength": 1 },
    "source_resolution": { "type": "string", "minLength": 1 },
    "required_evidence_level": { "type": "string", "minLength": 1 },
    "success_criteria": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "anti_goals": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
