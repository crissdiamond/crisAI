{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crisai.local/schemas/ui_run_request_v1.schema.json",
  "title": "crisAI UI Run Request",
  "type": "object",
  "required": ["schema_version", "message", "mode", "agent", "review", "verbose", "session"],
  "properties": {
    "schema_version": { "const": "ui_run_request_v1" },
    "message": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "minLength": 1 },
    "agent": { "type": "string", "minLength": 1 },
    "review": { "type": "boolean" },
    "verbose": { "type": "boolean" },
    "session": { "type": "string", "minLength": 1 },
    "retrieval_checkpoint": { "type": ["boolean", "null"] }
  },
  "additionalProperties": false
}
