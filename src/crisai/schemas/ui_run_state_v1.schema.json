{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crisai.local/schemas/ui_run_state_v1.schema.json",
  "title": "crisAI UI Run State",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "session",
    "status",
    "decision",
    "expected_stages",
    "events",
    "final_output",
    "error"
  ],
  "properties": {
    "schema_version": { "const": "ui_run_state_v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "session": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "decision": { "type": "object" },
    "expected_stages": {
      "type": "array",
      "items": { "type": "object" }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "ui_event_v1.schema.json" }
    },
    "final_output": { "type": "string" },
    "error": { "type": "string" },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
