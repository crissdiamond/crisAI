{
  "name": "crisai-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace @crisai/web run dev",
    "build:contracts": "npm --workspace @crisai/contracts run build",
    "build:web": "npm run build:contracts && npm --workspace @crisai/web run build",
    "dev:gem": "npm --workspace @crisai/gem run dev",
    "build:gem": "npm run build:contracts && npm --workspace @crisai/gem run build",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
