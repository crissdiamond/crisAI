#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

if [ ! -d ".venv" ]; then
  echo "Missing .venv. Create and install dependencies first:"
  echo "  python3 -m venv .venv"
  echo "  source .venv/bin/activate"
  echo "  pip install -e ."
  exit 1
fi

source .venv/bin/activate
export PYTHONPATH=./src

if [ -f .env ]; then
  set -a
  source .env
  set +a
fi

MODE="${1:-cli}"

case "$MODE" in
  cli)
    exec python -m crisai.cli.main classic
    ;;
  api)
    # FastAPI backend — required before starting web or gem.
    exec crisai-web
    ;;
  web)
    # React web client. Start the API server first: ./start api
    exec python -m crisai.cli.main web-react
    ;;
  gem)
    # Ink terminal client. Start the API server first: ./start api
    exec python -m crisai.cli.main gem-ink
    ;;
  gem-textual)
    # Legacy Textual terminal client.
    exec python -m crisai.cli.main gem
    ;;
  web-legacy)
    # Legacy static web app (served by the API server). Alias for: ./start api
    exec crisai-web
    ;;
  *)
    echo "Usage: ./start <command>"
    echo ""
    echo "  cli           Classic terminal CLI"
    echo "  api           FastAPI backend  (start this first for web and gem)"
    echo "  web           React web client (requires api)"
    echo "  gem           Ink terminal client (requires api)"
    echo ""
    echo "Legacy:"
    echo "  gem-textual   Textual terminal client"
    echo "  web-legacy    Static web app (alias for api)"
    exit 2
    ;;
esac
