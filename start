#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

if ! command -v uv >/dev/null 2>&1; then
  echo "uv not found. Install it first:"
  echo "  curl -LsSf https://astral.sh/uv/install.sh | sh"
  exit 1
fi

export PYTHONPATH=./src

if [ -f .env ]; then
  set -a
  source .env
  set +a
fi

MODE="${1:-gem}"
if [ "$#" -gt 0 ]; then
  shift
fi

has_hcom_assignments() {
  local assignments="reference/development/session_assignments.local.yaml"
  [[ -f "$assignments" ]] || return 1
  local role
  for role in \
    orchestrator_codex \
    gem_codex \
    web_codex \
    runtime_codex; do
    grep -q "^[[:space:]]\\+role: $role$" "$assignments" || return 1
  done
}

case "$MODE" in
  api)
    # FastAPI backend — required before starting web or gem.
    exec uv run crisai-web
    ;;
  web)
    # React web client. Start the API server first: ./start api
    exec uv run python -m crisai.cli.main web-react
    ;;
  cli|gem)
    # Ink terminal client. Start the API server first: ./start api
    exec uv run python -m crisai.cli.main gem-ink
    ;;
  hcom)
    # Start or resume the hcom development team.
    HCOM_START_ARGS=()
    HCOM_LIFECYCLE="ephemeral"
    HCOM_PROVIDER="claude-code"
    HCOM_MODEL_FAMILY=""
    HCOM_REVIEW_MODEL="${HCOM_TEAM_REVIEW_MODEL:-}"
    while [ "$#" -gt 0 ]; do
      case "$1" in
        all-up)
          HCOM_LIFECYCLE="persistent"
          shift
          ;;
        agy|antigravity)
          HCOM_PROVIDER="antigravity"
          shift
          ;;
        gemini)
          HCOM_MODEL_FAMILY="gemini"
          HCOM_REVIEW_MODEL="${HCOM_REVIEW_MODEL:-gemini-3-flash-preview}"
          shift
          ;;
        --)
          shift
          HCOM_START_ARGS+=("$@")
          break
          ;;
        *)
          echo "Unknown hcom option: $1" >&2
          echo "Usage: ./start hcom [all-up] [agy [gemini]] [-- scripts/hcom_start.sh args]" >&2
          exit 2
          ;;
      esac
    done
    if [ "$HCOM_MODEL_FAMILY" = "gemini" ] && [ "$HCOM_PROVIDER" != "antigravity" ]; then
      echo "hcom gemini reviewers require the agy/antigravity provider." >&2
      echo "Usage: ./start hcom [all-up] agy gemini [-- scripts/hcom_start.sh args]" >&2
      exit 2
    fi

    export HCOM_TEAM_REVIEW_LIFECYCLE="$HCOM_LIFECYCLE"
    export HCOM_TEAM_REVIEW_PROVIDER="$HCOM_PROVIDER"
    if [ -n "$HCOM_MODEL_FAMILY" ]; then
      export HCOM_TEAM_REVIEW_MODEL_FAMILY="$HCOM_MODEL_FAMILY"
    fi
    if [ -n "$HCOM_REVIEW_MODEL" ]; then
      export HCOM_TEAM_REVIEW_MODEL="$HCOM_REVIEW_MODEL"
    fi
    if has_hcom_assignments; then
      scripts/hcom_start.sh --resume "${HCOM_START_ARGS[@]}"
    else
      scripts/hcom_start.sh "${HCOM_START_ARGS[@]}"
    fi
    echo
    echo "hcom team is started. Attach with: ./start hcom-attach"
    ;;
  hcom-attach)
    # Attach to the running hcom tmux session.
    exec scripts/hcom_attach.sh
    ;;
  *)
    echo "Usage: ./start <command>"
    echo ""
    echo "  api           FastAPI backend  (start this first for web and gem)"
    echo "  web           React web client (requires api)"
    echo "  gem           Ink terminal client (requires api)"
    echo "  cli           Alias for gem"
    echo "  hcom          Start or resume the hcom development team"
    echo "  hcom all-up   Start/resume Codex plus persistent reviewers"
    echo "  hcom agy      Use Antigravity for reviewer launches"
    echo "  hcom agy gemini"
    echo "                Use Antigravity reviewers with gemini-3-flash-preview"
    echo "  hcom-attach   Attach to the hcom tmux session"
    exit 2
    ;;
esac
