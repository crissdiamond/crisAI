#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

if ! command -v uv >/dev/null 2>&1; then
  echo "uv not found. Install it first:"
  echo "  curl -LsSf https://astral.sh/uv/install.sh | sh"
  exit 1
fi

export PYTHONPATH=./src

if [ -f .env ]; then
  set -a
  source .env
  set +a
fi

MODE="${1:-gem}"
if [ "$#" -gt 0 ]; then
  shift
fi

has_hcom_assignments() {
  local assignments="reference/development/session_assignments.local.yaml"
  [[ -f "$assignments" ]] || return 1
  local profile="$1"
  local roles=()
  if [[ "$profile" == "claude-dev-codex-review" ]]; then
    roles=(
      orchestrator_claude
      gem_claude_dev
      gem_codex_review
      web_claude_dev
      web_codex_review
      runtime_claude_dev
      runtime_codex_review
    )
  else
    roles=(
      orchestrator_codex
      gem_codex
      web_codex
      runtime_codex
    )
  fi
  local role
  for role in "${roles[@]}"; do
    grep -q "^[[:space:]]\\+role: $role$" "$assignments" || return 1
  done
}

case "$MODE" in
  api)
    # FastAPI backend — required before starting web or gem.
    exec uv run crisai-web
    ;;
  web)
    # React web client. Start the API server first: ./start api
    exec uv run python -m crisai.cli.main web-react
    ;;
  cli|gem)
    # Ink terminal client. Start the API server first: ./start api
    exec uv run python -m crisai.cli.main gem-ink
    ;;
  hcom)
    # Start or resume the hcom development team.
    HCOM_START_ARGS=()
    HCOM_LIFECYCLE="ephemeral"
    HCOM_PROVIDER="claude-code"
    HCOM_AGY_PROFILE="claude"
    HCOM_PROFILE="codex-dev"
    while [ "$#" -gt 0 ]; do
      case "$1" in
        all-up)
          HCOM_LIFECYCLE="persistent"
          shift
          ;;
        agy|antigravity)
          HCOM_PROVIDER="antigravity"
          shift
          ;;
        claude)
          HCOM_AGY_PROFILE="claude"
          shift
          ;;
        gemini)
          HCOM_AGY_PROFILE="gemini"
          shift
          ;;
        claude-dev|claude-main|claude-coders)
          HCOM_PROFILE="claude-dev-codex-review"
          HCOM_LIFECYCLE="persistent"
          HCOM_PROVIDER="codex"
          shift
          ;;
        --)
          shift
          HCOM_START_ARGS+=("$@")
          break
          ;;
        *)
          echo "Unknown hcom option: $1" >&2
          echo "Usage: ./start hcom [all-up] [agy [claude|gemini]] [claude-dev] [-- scripts/hcom_start.sh args]" >&2
          exit 2
          ;;
      esac
    done

    export HCOM_TEAM_PROFILE="$HCOM_PROFILE"
    export HCOM_TEAM_REVIEW_LIFECYCLE="$HCOM_LIFECYCLE"
    export HCOM_TEAM_REVIEW_PROVIDER="$HCOM_PROVIDER"
    if [ "$HCOM_PROVIDER" = "antigravity" ]; then
      case "$HCOM_AGY_PROFILE" in
        claude)
          export HCOM_TEAM_ANTIGRAVITY_MODEL="${HCOM_TEAM_ANTIGRAVITY_CLAUDE_MODEL:-Claude Sonnet 4.6 (Thinking)}"
          export HCOM_TEAM_ANTIGRAVITY_MODEL_FRAGMENT="${HCOM_TEAM_ANTIGRAVITY_CLAUDE_MODEL_FRAGMENT:-Claude Sonnet 4.6}"
          ;;
        gemini)
          export HCOM_TEAM_ANTIGRAVITY_MODEL="${HCOM_TEAM_ANTIGRAVITY_GEMINI_MODEL:-Gemini 3.5 Flash (Medium)}"
          export HCOM_TEAM_ANTIGRAVITY_MODEL_FRAGMENT="${HCOM_TEAM_ANTIGRAVITY_GEMINI_MODEL_FRAGMENT:-Gemini 3.5 Flash}"
          ;;
        *)
          echo "Unknown Antigravity model profile: $HCOM_AGY_PROFILE" >&2
          exit 2
          ;;
      esac
    fi
    if has_hcom_assignments "$HCOM_PROFILE"; then
      scripts/hcom_start.sh --resume "${HCOM_START_ARGS[@]}"
    else
      scripts/hcom_start.sh "${HCOM_START_ARGS[@]}"
    fi
    echo
    echo "hcom team is started. Attach with: ./start hcom-attach"
    ;;
  hcom-attach)
    # Attach to the running hcom tmux session.
    exec scripts/hcom_attach.sh
    ;;
  knowledge)
    # Sync the curated knowledge base into workspace/knowledge from the
    # repository in CRISAI_KNOWLEDGE_REPO: clone on first run, fast-forward pull
    # thereafter. See DOCUMENTATION.md "Building the knowledge base".
    KNOWLEDGE_DIR="workspace/knowledge"
    if [ -z "${CRISAI_KNOWLEDGE_REPO:-}" ]; then
      echo "CRISAI_KNOWLEDGE_REPO is not set." >&2
      echo "Set it in .env to your knowledge repository URL, for example:" >&2
      echo "  CRISAI_KNOWLEDGE_REPO=git@github.com:<org>/<knowledge-repo>.git" >&2
      exit 2
    fi
    if [ -d "$KNOWLEDGE_DIR/.git" ]; then
      echo "Updating $KNOWLEDGE_DIR from CRISAI_KNOWLEDGE_REPO ..."
      exec git -C "$KNOWLEDGE_DIR" pull --ff-only
    elif [ -e "$KNOWLEDGE_DIR" ] && [ -n "$(ls -A "$KNOWLEDGE_DIR" 2>/dev/null)" ]; then
      echo "$KNOWLEDGE_DIR already has content but is not a clone of the knowledge repo." >&2
      echo "This install still tracks knowledge inside the crisAI repo. One-time migration" >&2
      echo "to adopt the external repo (your local files are preserved as a .bak):" >&2
      echo "  git rm -r --cached $KNOWLEDGE_DIR && echo '$KNOWLEDGE_DIR/' >> .gitignore" >&2
      echo "  mv $KNOWLEDGE_DIR ${KNOWLEDGE_DIR}.bak && ./start knowledge" >&2
      exit 2
    else
      echo "Cloning CRISAI_KNOWLEDGE_REPO into $KNOWLEDGE_DIR ..."
      mkdir -p "$(dirname "$KNOWLEDGE_DIR")"
      exec git clone "$CRISAI_KNOWLEDGE_REPO" "$KNOWLEDGE_DIR"
    fi
    ;;
  *)
    echo "Usage: ./start <command>"
    echo ""
    echo "  api           FastAPI backend  (start this first for web and gem)"
    echo "  web           React web client (requires api)"
    echo "  gem           Ink terminal client (requires api)"
    echo "  cli           Alias for gem"
    echo "  hcom          Start or resume the hcom development team"
    echo "  hcom all-up   Start/resume Codex plus persistent reviewers"
    echo "  hcom agy      Use Antigravity for reviewer launches"
    echo "  hcom agy gemini"
    echo "                Use Antigravity reviewers with the Gemini model profile"
    echo "  hcom claude-dev"
    echo "                Start Claude Code developers with Codex reviewers"
    echo "  hcom-attach   Attach to the hcom tmux session"
    echo "  knowledge     Sync workspace/knowledge from CRISAI_KNOWLEDGE_REPO (clone or pull)"
    exit 2
    ;;
esac
